# Local Docker development database (use docker-compose defaults locally).
POSTGRES_DB=gepeto
POSTGRES_USER=gepeto
POSTGRES_PASSWORD=change-this-long-random-password
DATABASE_URL=postgresql://gepeto:change-this-long-random-password@db:5432/gepeto

# Optional local queue; not required by the current API.
REDIS_URL=redis://redis:6379/0

# AI inference. Never commit real keys.
OPENROUTER_API_KEY=
LOCAL_OPENAI_BASE_URL=
LOCAL_MODEL=

# Required before enabling the protected legacy import endpoint.
GEPETO_IMPORT_TOKEN=

# Comma-separated exact browser origins, e.g. https://your-domain.example
# Leave empty for same-origin/local API use. Do not use "*" with credentials.
CORS_ORIGINS=
LOG_LEVEL=INFO

# Production Supabase:
# Set DATABASE_URL in the hosting provider's encrypted secret manager.
# Use the Supabase Connect dialog's connection string and correct pooler mode
# for the host network (IPv4-only/serverless generally needs Supavisor pooler).
# Never put the database password in this file, GitHub, or browser variables.
